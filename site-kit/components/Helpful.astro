---
/**
 * Was-this-helpful vote. Markup is the same for every visitor so the page can stay cached; counts
 * and the comment box load in the browser. When the host gives EmDash the visitor's address
 * (Cloudflare, or trustedProxyHeaders) everyone votes through the guest route. Otherwise votes go
 * through the member route: a member's vote counts, and a guest is shown the sign-in link.
 */
import { jsonForScript } from "../lib/knowx";
import { kx } from "../lib/knowx-strings";
import "../styles/wbcom-base.css";
import "../styles/knowx.css";

interface Props {
	id: string;
}

const { id } = Astro.props;
const copy = jsonForScript({
	yes: kx.helpfulYes,
	no: kx.helpfulNo,
	thanks: kx.helpfulThanks,
	commentThanks: kx.helpfulCommentThanks,
	tally: kx.helpfulTally,
	commentLabel: kx.helpfulCommentLabel,
	commentHint: kx.helpfulCommentHint,
	commentSend: kx.helpfulCommentSend,
	error: kx.helpfulError,
	stillTitle: kx.stillNeedTitle,
	stillBody: kx.stillNeedBody,
	stillButton: kx.stillNeedButton,
	question: kx.helpfulQuestion,
	signIn: kx.helpfulSignIn,
});
const signIn = `/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname)}`;
---

<section class="wb wb-card" data-kx-helpful data-id={id} aria-labelledby="kx-helpful-h">
	<script type="application/json" data-kx-helpful-copy set:html={copy}></script>
	<h2 id="kx-helpful-h">{kx.helpfulQuestion}</h2>
	<p class="wb-sr" data-kx-tally hidden></p>
	<p class="wb-muted" data-kx-signin aria-live="polite" tabindex="-1" hidden><span data-kx-signin-text>{kx.helpfulSignIn}</span> <a href={signIn}>{kx.helpfulSignInLink}</a></p>
	<div class="wb-summary" data-kx-buttons>
		<button class="wb-btn wb-btn--quiet" type="button" data-kx-vote="yes" aria-pressed="false">{kx.helpfulYes}</button>
		<button class="wb-btn wb-btn--quiet" type="button" data-kx-vote="no" aria-pressed="false">{kx.helpfulNo}</button>
	</div>
	<form data-kx-comment hidden>
		<label class="wb-label" for={`kx-comment-${id}`}>{kx.helpfulCommentLabel}</label>
		<textarea class="wb-input" id={`kx-comment-${id}`} name="comment" maxlength="500"></textarea>
		<p class="wb-muted">{kx.helpfulCommentHint}</p>
		<button class="wb-btn" type="submit">{kx.helpfulCommentSend}</button>
	</form>
	<p class="wb-status" data-kx-status role="status" hidden></p>
	<aside data-kx-contact hidden>
		<h3>{kx.stillNeedTitle}</h3>
		<p class="wb-muted">{kx.stillNeedBody}</p>
		<p>
			<a class="wb-btn" data-kx-contact-link href="#">{kx.stillNeedButton}</a>
		</p>
	</aside>
</section>

<script is:inline>
	// On a cold load the kit script below can bind a few seconds after the buttons show. A Yes or No
	// clicked before then is kept here (the button shows as pending) and sent once it binds.
	if (!window.kxEarlyClicks) {
		window.kxEarlyClicks = true;
		document.addEventListener("click", (event) => {
			const button = event.target instanceof Element ? event.target.closest("[data-kx-vote]") : null;
			const root = button && button.closest("[data-kx-helpful]");
			if (!root || root.dataset.kxReady) return;
			root.dataset.kxQueued = button.dataset.kxVote;
			button.setAttribute("aria-busy", "true");
		});
	}
</script>

<script>
	import { api } from "../lib/wbcom-kit";
	import { phrase } from "../lib/knowx-strings";
	import { visitorId } from "../lib/knowx";

	/** Refusals that mean "sign in to do this", from this engine or the one before it. */
	const SIGN_IN_CODES = new Set(["SIGN_IN_REQUIRED", "GUEST_UNAVAILABLE"]);

	function copyOf(root: HTMLElement) {
		try {
			return JSON.parse(root.querySelector("[data-kx-helpful-copy]")?.textContent || "{}") as Record<string, string>;
		} catch {
			return {};
		}
	}

	async function tally(root: HTMLElement, id: string, line: string) {
		const data = await api("knowx", `tally?id=${encodeURIComponent(id)}`);
		const box = root.querySelector<HTMLElement>("[data-kx-tally]");
		// No phrase (an older strings file): leave the screen-reader line hidden rather than empty.
		if (box && data.ok && line) {
			const yes = Number(data.yes) || 0;
			const total = yes + (Number(data.no) || 0);
			box.hidden = false;
			box.textContent = line.replaceAll("{yes}", String(yes)).replaceAll("{total}", String(total));
		}
	}

	/** The button for the vote that counted looks chosen; the other one goes quiet. */
	function markChoice(root: HTMLElement, helpful: boolean) {
		root.querySelectorAll<HTMLButtonElement>("[data-kx-vote]").forEach((button) => {
			const chosen = (button.dataset.kxVote === "yes") === helpful;
			button.setAttribute("aria-pressed", String(chosen));
			button.classList.toggle("wb-btn--quiet", !chosen);
		});
	}

	/**
	 * Whether this host lets guests vote (it gives EmDash the visitor's address). It is the same for
	 * every page of the site, so it is asked once per browser session, never before a vote: on
	 * Cloudflare the health route takes seconds. Unknown (undefined) until health or a guest vote answers.
	 */
	const GUEST_KEY = "knowx-guest-writes";
	let guestWrites: boolean | undefined;
	try {
		const saved = sessionStorage.getItem(GUEST_KEY);
		if (saved !== null) guestWrites = saved === "1";
	} catch {
		guestWrites = undefined;
	}
	function rememberGuestWrites(value: boolean) {
		guestWrites = value;
		try {
			sessionStorage.setItem(GUEST_KEY, value ? "1" : "0");
		} catch {
			// Storage blocked: health is simply asked again on the next page.
		}
	}
	// A missing field (engine 0.1.4) means guests may vote.
	const guestWritesKnown: Promise<boolean | undefined> =
		guestWrites !== undefined || !document.querySelector("[data-kx-helpful]")
			? Promise.resolve(guestWrites)
			: api("knowx", "health").then((health) => {
					if (health.ok !== true) return guestWrites;
					// A guest vote that answered first already knows.
					if (guestWrites === undefined) rememberGuestWrites(health.guestWrites !== false);
					return guestWrites;
				});

	document.querySelectorAll<HTMLElement>("[data-kx-helpful]").forEach((root) => {
		const id = root.dataset.id || "";
		const copy = copyOf(root);
		const status = root.querySelector<HTMLElement>("[data-kx-status]");
		const commentForm = root.querySelector<HTMLFormElement>("[data-kx-comment]");
		const contact = root.querySelector<HTMLElement>("[data-kx-contact]");
		const contactLink = root.querySelector<HTMLAnchorElement>("[data-kx-contact-link]");
		const signIn = root.querySelector<HTMLElement>("[data-kx-signin]");
		const signInText = root.querySelector<HTMLElement>("[data-kx-signin-text]");
		const voteButtons = root.querySelectorAll<HTMLButtonElement>("[data-kx-vote]");
		let guestBlocked = false;
		let busy = false;
		let voted = false;

		// Config and the tally load side by side and never hold up a vote.
		const configLoaded = api("knowx", "config");
		configLoaded.then((config) => {
			if (contactLink && typeof config.contactUrl === "string" && config.contactUrl) contactLink.href = config.contactUrl;
		});
		void tally(root, id, copy.tally || "");

		// On a host with no visitor address, ask once whether this reader is a member. The member vote
		// route answers a guest with 401 (expected, documented) and a member with VALIDATION_ERROR for
		// the empty body, so nothing is stored. A guest then gets Yes and No marked unavailable (out of
		// the tab order) and the sign-in line as the action; a member votes as usual. Until this
		// answers, a click votes and the answer itself says whether to sign in.
		guestWritesKnown.then(async (allowed) => {
			if (allowed !== false) return;
			const probe = await api("knowx", "helpful_member", {});
			if (probe.error?.code !== "SIGN_IN_REQUIRED" || busy || voted) return;
			guestBlocked = true;
			voteButtons.forEach((button) => {
				button.disabled = true;
				button.setAttribute("aria-disabled", "true");
			});
			if (signIn) {
				if (signInText && copy.signIn) signInText.textContent = copy.signIn;
				signIn.hidden = false;
			}
		});

		const askToSignIn = () => {
			const buttons = root.querySelector<HTMLElement>("[data-kx-buttons]");
			if (buttons) buttons.hidden = true;
			if (status) status.hidden = true;
			if (signIn) {
				if (signInText && copy.signIn) signInText.textContent = copy.signIn;
				signIn.hidden = false;
				signIn.focus();
			}
		};

		const vote = async (helpful: boolean, pressed: HTMLButtonElement | null, comment = "") => {
			if (!status || guestBlocked || busy) return;
			busy = true;
			pressed?.setAttribute("aria-busy", "true");
			try {
				const body = { id, helpful, comment, vid: visitorId() };
				// A signed-in member votes only through the member route (one vote per member, never one by
				// address as well). It is tried on every click, so a reader who signs in during the visit
				// votes by account at once. A guest's click answers 401 there (expected, one per click) and
				// then uses the guest route; an engine without the member route (0.1.4) falls back the same
				// way. The guest route itself answers GUEST_UNAVAILABLE on a host with no visitor address
				// (engine 0.1.5 and later), so a vote never waits for health.
				let result = await api("knowx", "helpful_member", body);
				const code = result.error?.code;
				if (!result.ok && (code === "SIGN_IN_REQUIRED" || code === "FAILED" || code === "NOT_FOUND")) {
					if (guestWrites === false) result = { ok: false, error: { code: "GUEST_UNAVAILABLE" } };
					else {
						result = await api("knowx", "helpful", body);
						const reason = (result.error as { reason?: string } | undefined)?.reason;
						if (result.ok) rememberGuestWrites(true);
						else if (reason === "GUEST_UNAVAILABLE") rememberGuestWrites(false);
					}
				}
				status.hidden = false;
				const why = (result.error as { reason?: string } | undefined)?.reason || result.error?.code || "";
				if (SIGN_IN_CODES.has(why)) {
					askToSignIn();
					return;
				}
				if (!result.ok) {
					status.dataset.tone = "error";
					status.textContent = phrase(result.error?.code);
					return;
				}
				voted = true;
				status.dataset.tone = "success";
				// The vote counted, so this reader may vote here: the members-only hint has done its job.
				if (signIn) signIn.hidden = true;
				// An older strings file may not have the newer phrases yet.
				status.textContent = (comment ? copy.commentThanks || copy.thanks : copy.thanks) || "";
				markChoice(root, helpful);
				const config = await configLoaded;
				const contactUrl = typeof config.contactUrl === "string" ? config.contactUrl : "";
				if (commentForm) commentForm.hidden = helpful || config.askComment === false || Boolean(comment);
				if (contact) contact.hidden = helpful || !contactUrl;
				void tally(root, id, copy.tally || "");
			} finally {
				busy = false;
				pressed?.removeAttribute("aria-busy");
			}
		};

		voteButtons.forEach((button) => {
			button.addEventListener("click", () => vote(button.dataset.kxVote === "yes", button));
		});
		// Send a click that came before this script ran (kept by the inline script above).
		root.dataset.kxReady = "1";
		const queued = root.querySelector<HTMLButtonElement>(`[data-kx-vote="${root.dataset.kxQueued}"]`);
		delete root.dataset.kxQueued;
		if (queued) void vote(queued.dataset.kxVote === "yes", queued);

		commentForm?.addEventListener("submit", (event) => {
			event.preventDefault();
			const text = String(new FormData(commentForm).get("comment") || "");
			vote(false, commentForm.querySelector<HTMLButtonElement>("button[type=submit]"), text);
		});
	});
</script>
