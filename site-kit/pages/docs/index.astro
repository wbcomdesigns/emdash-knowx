---
import { getEmDashCollection, getTaxonomyTerms } from "emdash";
import DocSearch from "../../components/DocSearch.astro";
import Layout from "../../layouts/KnowXLayout.astro";
import { loadConfig, loadProducts } from "../../lib/knowx";
import { productIcon } from "../../lib/knowx-icons";
import { kx } from "../../lib/knowx-strings";
import { useProductLayer } from "../../lib/knowx-products";
import "../../styles/wbcom-base.css";
import "../../styles/knowx.css";

// Every published article is reachable from here: newest first, a page at a time (#64).
const ARTICLES_PAGE = 10;
const after = Astro.url.searchParams.get("after") || undefined;
const [config, products, terms, docs] = await Promise.all([
	loadConfig(Astro.locals),
	loadProducts(Astro.locals),
	getTaxonomyTerms("doc_category").catch(() => []),
	getEmDashCollection("docs", { orderBy: { published_at: "desc" }, limit: ARTICLES_PAGE, cursor: after }),
]);
if (Astro.cache?.enabled) Astro.cache.set(docs.cacheHint);

type Term = { slug: string; count?: number; children?: Term[] };
const top = terms.filter((term) => !term.parentId);
const productLayer = products.productLayer || useProductLayer(top.length);
const allTerms = (items: Term[]): Term[] => items.flatMap((term) => [term, ...allTerms(term.children ?? [])]);
const countFor = (slug: string) => allTerms(terms).find((term) => term.slug === slug)?.count ?? 0;

const cards = (products.items.length ? products.items : top.map((term) => ({
	slug: term.slug,
	label: term.label,
	description: term.description || "",
	icon: "book",
}))).map((item) => ({
	...item,
	// Articles filed directly in this category, as its page lists them; sub-categories are named
	// apart, so a parent whose articles sit in sub-categories does not read as nearly empty.
	count: countFor(item.slug),
	subtopics: top.find((term) => term.slug === item.slug)?.children?.length ?? 0,
}));

const articles = docs.entries;
const nextPage = docs.nextCursor ? `?after=${encodeURIComponent(docs.nextCursor)}#articles` : "";
---

<Layout title={kx.homeTitle} description={kx.homeLead}>
	<div class="wb kx">
		<header class="kx-hero">
			<h1>{kx.homeTitle}</h1>
			<p>{kx.homeLead}</p>
			<DocSearch collections={config.searchCollections} />
		</header>

		{
			cards.length ? (
				<section class="kx-section">
					<h2>{kx.categoriesHeading}</h2>
					<ul class={productLayer ? "kx-grid" : "kx-list"}>
						{cards.map((item) => (
							<li>
								<a class={productLayer ? "kx-card" : "wb-item"} href={`/docs/category/${item.slug}`}>
									{productLayer ? (
										<svg class="kx-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={productIcon(item.icon)} />
									) : null}
									<strong>{item.label}</strong>
									{item.description ? <span class="wb-muted">{item.description}</span> : null}
									<span class="kx-count">{item.subtopics ? `${kx.articlesCount(item.count)}, ${kx.subtopicsCount(item.subtopics)}` : kx.articlesCount(item.count)}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			) : null
		}

		{
			articles.length || after ? (
				<section class="kx-section" id="articles">
					<h2>{kx.articlesHeading}</h2>
					<ul class="kx-list">
						{articles.map((entry) => (
							<li>
								<a class="wb-item" href={`/docs/${entry.data.slug || entry.id}`}>
									<strong>{entry.data.title}</strong>
									{entry.data.excerpt ? <span class="wb-muted">{entry.data.excerpt}</span> : null}
								</a>
							</li>
						))}
					</ul>
					{nextPage || after ? (
						<nav class="kx-more" aria-label={kx.articlesHeading}>
							{after ? <a class="wb-btn wb-btn--quiet" href={`${Astro.url.pathname}#articles`}>{kx.newestArticles}</a> : null}
							{nextPage ? <a class="wb-btn" href={nextPage}>{kx.moreArticles}</a> : null}
						</nav>
					) : null}
				</section>
			) : cards.length ? null : (
				<div class="wb-empty">
					<p>
						<strong>{kx.emptyHomeTitle}</strong>
					</p>
					<p class="wb-muted">{kx.emptyHomeHint}</p>
				</div>
			)
		}
	</div>
</Layout>
