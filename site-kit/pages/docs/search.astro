---
import { getEmDashCollection, search, getSiteSettings } from "emdash";
import StillNeedHelp from "../../components/StillNeedHelp.astro";
import Layout from "../../layouts/KnowXLayout.astro";
import { HELP_PATH, jsonForScript, loadConfig, resultHref, resultKind, resultSnippet, SEARCH_ROUTES } from "../../lib/knowx";
import { kx } from "../../lib/knowx-strings";
import "../../styles/wbcom-base.css";
import "../../styles/knowx.css";

const q = (Astro.url.searchParams.get("q") || "").trim();
const honeypot = Astro.url.searchParams.get("website") || "";
const config = await loadConfig(Astro.locals);
let items: Array<{ collection: string; slug: string | null; title?: string; snippetHtml: string; excerpt: string }> = [];
let failed = false;
if (q) {
	try {
		const result = await search(q, { collections: config.searchCollections, limit: 20 });
		const needExcerpt = result.items.some((item) => !resultSnippet(item.title || "", item.snippet));
		const excerpts = new Map<string, string>();
		if (needExcerpt) {
			const docs = await getEmDashCollection("docs", { limit: 200 }).catch(() => null);
			for (const entry of docs?.entries ?? []) {
				const slug = typeof entry.data.slug === "string" && entry.data.slug ? entry.data.slug : String(entry.id || "");
				const excerpt = typeof entry.data.excerpt === "string" ? entry.data.excerpt.trim() : "";
				if (slug && excerpt) excerpts.set(slug, excerpt);
			}
		}
		items = result.items.map((item) => {
			const snippetHtml = resultSnippet(item.title || "", item.snippet);
			const excerpt = !snippetHtml && item.slug ? excerpts.get(item.slug) || "" : "";
			return { collection: item.collection, slug: item.slug, title: item.title, snippetHtml, excerpt };
		});
	} catch {
		failed = true;
	}
}

const title = q ? kx.searchResultsFor(q) : kx.searchTitle;
// The search is counted from the browser, so the request carries the visitor's address: it is only
// counted when the host gives EmDash that address (owner decision 2026-10-16). The markup is the
// same for every visitor, so the page can be cached.
const log = q && !failed && !honeypot ? jsonForScript({ q, found: items.length }) : "";
---

<Layout title={title} description={kx.homeLead}>
	<div class="wb kx">
		<header class="kx-hero">
			<h1>{title}</h1>
			<form class="kx-search-form" action={`${HELP_PATH}/search`} method="get">
				<label class="wb-sr" for="kx-q">{kx.searchPlaceholder}</label>
				<input class="wb-input" id="kx-q" type="search" name="q" value={q} placeholder={kx.searchPlaceholder} />
				<input class="kx-hp" type="text" name="website" tabindex="-1" autocomplete="off" />
				<button class="wb-btn" type="submit">{kx.searchSubmit}</button>
			</form>
		</header>

		{
			failed ? (
				<div class="wb-status" data-tone="error">{kx.searchError}</div>
			) : !q ? (
				<p class="wb-muted">{kx.searchPrompt}</p>
			) : items.length ? (
				<ul class="kx-list">
					{items.map((item) => (
						<li>
							<a class="kx-result" href={resultHref(item.collection, item.slug, SEARCH_ROUTES)}>
								<span class="kx-kind">{resultKind(item.collection)}</span>
								<strong>{item.title || item.slug}</strong>
								{item.snippetHtml ? <span class="wb-muted" set:html={item.snippetHtml} /> : item.excerpt ? <span class="wb-muted">{item.excerpt}</span> : null}
							</a>
						</li>
					))}
				</ul>
			) : (
				<div class="wb-empty">
					<p>
						<strong>{kx.searchNone}</strong>
					</p>
					<p class="wb-muted">{kx.searchNoneHint}</p>
					<p>
						<a class="wb-btn" href={HELP_PATH}>{kx.backHome}</a>
					</p>
				</div>
			)
		}

		{q && !items.length && !failed ? <StillNeedHelp href={config.contactUrl} /> : null}
	</div>
	{log ? <script type="application/json" data-kx-search-log set:html={log} /> : null}
</Layout>

<script>
	import { api } from "../../lib/wbcom-kit";
	import { visitorId } from "../../lib/knowx";

	const box = document.querySelector("[data-kx-search-log]");
	if (box) {
		try {
			const { q, found } = JSON.parse(box.textContent || "{}");
			// Fire and forget: a refused or failed log never changes what the visitor sees. With no
			// visitor address on this host the route refuses and nothing is counted.
			void api("knowx", "log_search", { q, found, vid: visitorId() });
		} catch {
			/* nothing to log */
		}
	}
</script>
