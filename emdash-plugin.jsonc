{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "knowx",
	"name": "KnowX Knowledge Base",
	"keywords": [
		"knowledge base",
		"docs",
		"help center",
		"support",
		"search"
	],
	"publisher": "did:plc:2o6axbe264shvyedyhycyhya",
	"license": "MIT",
	"repo": "https://github.com/wbcomdesigns/emdash-knowx",
	"author": {
		"name": "Wbcom Designs",
		"url": "https://wbcomdesigns.com",
		"email": "security@wbcomdesigns.com"
	},
	"security": {
		"email": "security@wbcomdesigns.com"
	},
	"description": "A searchable knowledge base for EmDash: categories, article feedback, and a report of what readers search for.",
	"capabilities": [
		"content:read",
		"schema:read",
		"taxonomies:read"
	],
	"allowedHosts": [],
	"storage": {
		"feedback": {
			"indexes": [
				"doc",
				"doc_helpful",
				"createdAt"
			]
		},
		"searches": {
			"indexes": [
				"found",
				"count",
				"lastAt"
			]
		},
		"product_icons": {
			"indexes": [
				"slug",
				"icon"
			]
		}
	},
	"admin": {
		"pages": [
			{
				"path": "/insights",
				"label": "Insights",
				"icon": "chart",
				"group": "KnowX"
			},
			{
				"path": "/settings",
				"label": "Settings",
				"icon": "settings",
				"group": "KnowX"
			}
		]
	},
	"release": {
		"artifacts": {
			"icon": {
				"file": "./icon.png"
			},
			"banner": {
				"file": "./images/banner.png"
			}
		}
	}
}
